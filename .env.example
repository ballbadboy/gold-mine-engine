# ════════════════════════════════════════════════════════
#  Gold Mine Engine — Environment Template
#  Copy to .env.local (git-ignored) and fill in values
# ════════════════════════════════════════════════════════

# ── Project ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Gold Mine Engine"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="th"

# ── Supabase ────────────────────────────────────────────
# Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""          # server-only, never expose
SUPABASE_DB_URL=""                     # for migrations

# ── LLM Providers ──────────────────────────────────────
# Primary: Claude (Anthropic)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-6"

# Cheap/bulk: Gemini (Google)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Fallback: OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.6"

# Embeddings
VOYAGE_API_KEY=""                      # or OpenAI

# ── Analytics (Read-back for Loop) ─────────────────────
# Google Analytics 4 (via Service Account)
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_JSON=""            # path or JSON string

# Google Search Console
GSC_SITE_URL=""
GSC_SERVICE_ACCOUNT_JSON=""

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""

# ── Affiliate Platforms ────────────────────────────────
# Shopee (TH)
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
SHOPEE_AFFILIATE_ID=""

# Lazada (TH)
LAZADA_APP_KEY=""
LAZADA_APP_SECRET=""

# Amazon Associates
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TAG=""
AMAZON_REGION="us-east-1"

# Involve Asia (gateway: iHerb, Agoda, etc.)
INVOLVE_ASIA_API_KEY=""
INVOLVE_ASIA_SECRET=""

# ── Queue / Cron ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ── Deployment ─────────────────────────────────────────
VERCEL_PROJECT_ID=""
VERCEL_ORG_ID=""

# ── Multi-Tenant (Phase 3+) ────────────────────────────
# Default tenant for solo use; multi-tenant kicks in later
DEFAULT_TENANT_ID="tenant_owner"

# ── Feature Flags ──────────────────────────────────────
LOOP_ENABLED="false"                   # turn on when Sprint 3
AUTO_APPLY_CHANGES="false"             # human-in-loop default

# ── Marketing Workspace (owner-only pilot) ─────────────
# Exact public HTTPS origin in production; include port for local development.
APP_ORIGIN="http://localhost:3000"
# Set these with `pnpm setup:admin` (scrypt hash; never a plaintext password).
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""               # random, at least 32 characters
MARKETING_STORE="supabase"            # file is LOCAL DEVELOPMENT ONLY
MARKETING_WORKSPACE_ID="owner"        # one owner workspace per deployment
MARKETING_WEBHOOK_SECRET=""           # independent random key, at least 32 chars
MARKETING_PLAYER_HASH_SECRET=""       # stable independent key; do not rotate without migrating IDs
# Optional local storage path, never a production database:
# MARKETING_DATA_DIR=".data"
# Do not enable demo in hosted deployments; `pnpm demo` sets it locally.
MARKETING_DEMO_MODE="false"

# Scope public published content to exactly one website ID. Blank = no public content.
PUBLIC_CONTENT_WEBSITE_ID=""
# Used by the legacy cron handler, not needed for the marketing demo.
CRON_SECRET=""                        # independent random key, at least 32 chars
